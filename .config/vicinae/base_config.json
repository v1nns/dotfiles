{
  "close_on_focus_loss": false,
  "favicon_service": "twenty",
  "font": {
    "size": 10.5
  },
  "keybinding": "default",
  "keybinds": {},
  "pop_to_root_on_close": true,
  "search_files_in_root": false,
  "theme": {
    "dark": {
      "name": "tokyo-night"
    }
  },
  "launcher_window": {
    "opacity": 0.98,
    "client_side_decorations": {
      "enabled": true,
      "rounding": 10,
      "border_width": 1
    }
  },
  "favorites": [
    "applications:brave-browser"
  ],
  "providers": {
    "applications": {
      "entrypoints": {
        "shutdown": {
          "enabled": false
        }
      }
    }
  }
}
