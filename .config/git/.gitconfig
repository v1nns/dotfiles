[color]
	ui = true
[user]
	name = Vinicius M. Longaray
	email = vmouralongaray@gmail.com
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
[pull]
	rebase = false
[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
[push]
	autoSetupRemote = true
